+	if type(where) == "string" then
+		origin = GetPosition("where", 0);
+	elseif IsAround(where) then
+		origin = GetPosition(where);
+	else
+		origin = where;
+	end
+	
+	local pos = GetPositionNear(origin, minRadius, maxRadius);
