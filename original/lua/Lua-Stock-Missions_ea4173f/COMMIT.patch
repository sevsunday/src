+    Mission.m_AICraftHandles[index] = BuildObject(NewCraftsODF, theirTeam, Where)
+    local h = Mission.m_AICraftHandles[index]
+    SetRandomHeadingAngle(h)
+    SetNoScrapFlagByHandle(h)
+    AddPilotByHandle(h)
+    
+    FindGoodAITarget(index)
+end
